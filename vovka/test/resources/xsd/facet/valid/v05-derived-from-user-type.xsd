<?xml version="1.0" encoding="UTF-8"?>
<!--
  ДОПУСТИМЫЙ ВАРИАНТ. ПРАВИЛО 1. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО ПРОВЕРЯЕМ:
    Тип ShortName сужает пользовательский тип Name и добавляет только xs:minLength.

  ПОЧЕМУ ЭТО НЕ НАРУШЕНИЕ:
    Restriction от пользовательского типа не проверяется: ограничение xs:maxLength уже есть
    у базового типа Name, а сам Name проверяется в своём объявлении.

  ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
    Валидация проходит без исключения.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- Вспомогательный тип: строка до 50 символов. Сам правила не нарушает. -->
    <xs:simpleType name="Name">
        <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="ShortName">
        <xs:restriction base="t:Name">
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:element name="shortName" type="t:ShortName"/>

</xs:schema>
