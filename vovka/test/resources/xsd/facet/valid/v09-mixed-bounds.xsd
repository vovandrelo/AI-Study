<?xml version="1.0" encoding="UTF-8"?>
<!--
  ДОПУСТИМЫЙ ВАРИАНТ. ПРАВИЛО 2. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО ПРОВЕРЯЕМ:
    Границы разного вида: нижняя включительно, верхняя не включительно.

  ПОЧЕМУ ЭТО НЕ НАРУШЕНИЕ:
    Подходит любая комбинация одной min-границы и одной max-границы.

  ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
    Валидация проходит без исключения.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="Delta">
        <xs:restriction base="xs:nonPositiveInteger">
            <xs:minInclusive value="-100"/>
            <xs:maxExclusive value="0"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:element name="delta" type="t:Delta"/>

</xs:schema>
