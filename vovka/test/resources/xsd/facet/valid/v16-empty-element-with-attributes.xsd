<?xml version="1.0" encoding="UTF-8"?>
<!--
  ДОПУСТИМЫЙ ВАРИАНТ. ПРАВИЛА 1 и 3.

  ЧТО ПРОВЕРЯЕМ:
    Сложный тип без дочерних элементов, только с атрибутами.

  ПОЧЕМУ ЭТО НЕ НАРУШЕНИЕ:
    У элемента есть тип (анонимный complexType), атрибуты типизированы.

  ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
    Валидация проходит без исключения.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- Вспомогательный тип: строка до 50 символов. Сам правила не нарушает. -->
    <xs:simpleType name="Name">
        <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:element name="flag">
        <xs:complexType>
            <xs:attribute name="code" type="t:Name"/>
            <xs:attribute name="on" type="xs:boolean"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
