<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРЕФИКСЫ. ДОПУСТИМЫЙ ВАРИАНТ. ПРАВИЛО 1. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО ПРОВЕРЯЕМ:
    Пространство по умолчанию здесь НАШЕ (urn:test:facet), а XML Schema под префиксом xs.
    В нашем пространстве объявлен свой тип с именем "string", ограниченный xs:maxLength.
    Элемент name ссылается на него как type="string".

  ПОЧЕМУ ЭТО НЕ НАРУШЕНИЕ:
    Валидатор смотрит на пространство имён, а не на текст. type="string" здесь означает
    тип string из urn:test:facet, то есть наш ограниченный тип, а не xs:string.

  ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
    Валидация проходит без исключения.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- Свой тип с неудачным, но допустимым именем string -->
    <xs:simpleType name="string">
        <xs:restriction base="xs:string">
            <xs:maxLength value="20"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- type="string" ссылается на наш тип: пространство по умолчанию urn:test:facet -->
    <xs:element name="name" type="string"/>

</xs:schema>
