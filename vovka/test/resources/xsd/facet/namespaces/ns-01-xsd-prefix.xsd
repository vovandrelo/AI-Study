<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРЕФИКСЫ. ПРАВИЛО 1. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО НАРУШЕНО:
    Пространство имён XML Schema объявлено с префиксом xsd, а не xs.
    Элемент name объявлен с type="xsd:string".

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Префикс выбирает автор схемы, важно только пространство имён за ним.
    xsd:string здесь это тот же самый встроенный xs:string, без ограничений.

  КАК ИСПРАВИТЬ:
    Как и для xs:string: свой ограниченный тип.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:element name="name"> type="xsd:string"
    для строкового типа должно быть задано ограничение
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:t="urn:test:facet"
            targetNamespace="urn:test:facet"
            elementFormDefault="qualified">

    <!-- НАРУШЕНИЕ: xsd:string это xs:string под другим префиксом -->
    <xsd:element name="name" type="xsd:string"/>

</xsd:schema>
