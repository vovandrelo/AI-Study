<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 1. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО НАРУШЕНО:
    В группе атрибутов Audit атрибут createdBy объявлен с type="xs:string".

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Группа атрибутов вставляется в элементы как есть, вместе с неограниченной строкой.

  КАК ИСПРАВИТЬ:
    type="t:Name" с ограниченным типом.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:attribute name="createdBy"> type="xs:string"
    для строкового типа должно быть задано ограничение
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:attributeGroup name="Audit">
        <!-- НАРУШЕНИЕ: неограниченная строка в группе атрибутов -->
        <xs:attribute name="createdBy" type="xs:string"/>
    </xs:attributeGroup>

</xs:schema>
