<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 1. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО НАРУШЕНО:
    Тип Code ограничен только xs:minLength.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    xs:minLength запрещает слишком короткие строки, но не длинные: сверху длина не ограничена.

  КАК ИСПРАВИТЬ:
    Добавить xs:maxLength (или xs:length, xs:enumeration, xs:pattern).

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:restriction base="xs:string"> (в <xs:simpleType name="Code">)
    не задан ни один из параметров xs:length, xs:maxLength, xs:enumeration, xs:pattern
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="Code">
        <xs:restriction base="xs:string">
            <!-- НАРУШЕНИЕ: есть только нижний предел длины -->
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
