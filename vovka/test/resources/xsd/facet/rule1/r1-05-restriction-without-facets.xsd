<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 1. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО НАРУШЕНО:
    Тип Code сужает xs:string, но внутри restriction нет ни одного фасета.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Пустой restriction ничего не сужает: Code равен xs:string.

  КАК ИСПРАВИТЬ:
    Добавить xs:maxLength, xs:length, xs:enumeration или xs:pattern.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:restriction base="xs:string"> (в <xs:simpleType name="Code">)
    не задан ни один из параметров xs:length, xs:maxLength, xs:enumeration, xs:pattern
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="Code">
        <!-- НАРУШЕНИЕ: restriction без фасетов -->
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

</xs:schema>
