<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 1. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО НАРУШЕНО:
    Глобальный атрибут lang объявлен с type="xs:string".

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Глобальный атрибут подключается через ref; проверяется в месте объявления.

  КАК ИСПРАВИТЬ:
    type="t:Name" с ограниченным типом.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:attribute name="lang"> type="xs:string"
    для строкового типа должно быть задано ограничение
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- НАРУШЕНИЕ: глобальный атрибут с неограниченной строкой -->
    <xs:attribute name="lang" type="xs:string"/>

</xs:schema>
