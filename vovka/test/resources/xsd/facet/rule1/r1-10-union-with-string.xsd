<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 1. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО НАРУШЕНО:
    Объединение DateOrText: xs:date или xs:string.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Значение подходит, если подходит под любую ветвь. Неограниченная строка снимает
    ограничение со всего объединения. Сообщение указывает конкретную ветвь.

  КАК ИСПРАВИТЬ:
    Заменить xs:string на ограниченный тип: memberTypes="xs:date t:Name".

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:union> memberTypes="xs:string" (в <xs:simpleType name="DateOrText">)
    для строкового типа должно быть задано ограничение
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="DateOrText">
        <!-- НАРУШЕНИЕ: одна из ветвей — неограниченная строка -->
        <xs:union memberTypes="xs:date xs:string"/>
    </xs:simpleType>

</xs:schema>
