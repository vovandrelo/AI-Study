<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 2. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО НАРУШЕНО:
    Тип Amount ограничен только xs:fractionDigits.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    xs:fractionDigits ограничивает только цифры после точки; целая часть может быть любой длины.

  КАК ИСПРАВИТЬ:
    Добавить xs:totalDigits.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:restriction base="xs:decimal"> (в <xs:simpleType name="Amount">)
    должен быть задан xs:totalDigits либо пара
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="Amount">
        <xs:restriction base="xs:decimal">
            <!-- НАРУШЕНИЕ: ограничена только дробная часть -->
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
