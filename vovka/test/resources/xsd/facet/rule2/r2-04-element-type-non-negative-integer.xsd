<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 2. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО НАРУШЕНО:
    Элемент value объявлен с type="xs:nonNegativeInteger".

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    У xs:nonNegativeInteger нет верхнего предела: ссылка по имени не даёт добавить ограничения.

  КАК ИСПРАВИТЬ:
    Объявить свой simpleType с restriction и xs:totalDigits (или min + max) и сослаться на него.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:element name="value"> type="xs:nonNegativeInteger"
    для числового типа должно быть задано ограничение
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- НАРУШЕНИЕ: type="xs:nonNegativeInteger" без ограничений -->
    <xs:element name="value" type="xs:nonNegativeInteger"/>

</xs:schema>
