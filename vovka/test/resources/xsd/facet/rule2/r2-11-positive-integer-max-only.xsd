<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 2. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО НАРУШЕНО:
    Тип Count на основе xs:positiveInteger ограничен только xs:maxInclusive.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    У xs:positiveInteger по стандарту есть нижний предел 1, но правило требует ЯВНО
    задать обе границы (или xs:totalDigits). Встроенная граница не засчитывается.

  КАК ИСПРАВИТЬ:
    Добавить xs:minInclusive value="1".

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:restriction base="xs:positiveInteger"> (в <xs:simpleType name="Count">)
    должен быть задан xs:totalDigits либо пара
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="Count">
        <xs:restriction base="xs:positiveInteger">
            <!-- НАРУШЕНИЕ: нижняя граница не задана явно -->
            <xs:maxInclusive value="999"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
