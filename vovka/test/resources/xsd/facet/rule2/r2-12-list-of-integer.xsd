<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 2. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО НАРУШЕНО:
    Список Ids состоит из элементов типа xs:integer.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Каждое число в списке может быть любой величины.

  КАК ИСПРАВИТЬ:
    itemType с ограниченным числовым типом.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:list> itemType="xs:integer" (в <xs:simpleType name="Ids">)
    для числового типа должно быть задано ограничение
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="Ids">
        <!-- НАРУШЕНИЕ: элементы списка не ограничены -->
        <xs:list itemType="xs:integer"/>
    </xs:simpleType>

</xs:schema>
