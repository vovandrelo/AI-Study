<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПОРЯДОК ВНУТРИ ФАЙЛА.

  ЧТО НАРУШЕНО:
    В файле два нарушения: сначала xs:any (правило 3), ниже type="xs:string" (правило 1).

  ЧТО ПРОВЕРЯЕМ:
    Теги проверяются сверху вниз, валидатор останавливается на первом нарушении.
    В сообщении должно быть только xs:any.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    использование xs:any запрещено
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- НАРУШЕНИЕ 1 (правило 3): найдётся первым -->
    <xs:element name="extra">
        <xs:complexType>
            <xs:sequence>
                <xs:any/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- НАРУШЕНИЕ 2 (правило 1): ниже по файлу, в сообщение не попадёт -->
    <xs:element name="name" type="xs:string"/>

</xs:schema>
