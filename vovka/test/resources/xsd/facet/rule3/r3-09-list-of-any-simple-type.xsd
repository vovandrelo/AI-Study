<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРАВИЛО 3. Запрещены xs:any, xs:anyType и xs:anySimpleType, в том числе неявные:
  элемент без типа получает xs:anyType, атрибут без типа получает xs:anySimpleType.

  ЧТО НАРУШЕНО:
    Список Values состоит из элементов типа xs:anySimpleType.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Каждый элемент списка может быть любым текстом.

  КАК ИСПРАВИТЬ:
    itemType с конкретным ограниченным типом.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:list> itemType="xs:anySimpleType" (в <xs:simpleType name="Values">)
    использование xs:anySimpleType запрещено
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="Values">
        <!-- НАРУШЕНИЕ: элементы списка любые -->
        <xs:list itemType="xs:anySimpleType"/>
    </xs:simpleType>

</xs:schema>
