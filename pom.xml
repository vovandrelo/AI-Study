<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>com.study.aiagents</groupId>
    <artifactId>ai-agents-study</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>AI Agents Study</name>
    <description>Поэтапное изучение ИИ-агентов на Java 21 + LangChain4j + LangGraph4j + Claude</description>

    <modules>
        <module>common-llm</module>
        <module>01-basic-chat</module>
        <module>02-chat-memory</module>
        <module>03-structured-output</module>
        <module>04-ai-services</module>
        <module>05-tools</module>
        <module>06-mcp-client</module>
        <module>07-mcp-server</module>
        <module>08-rag</module>
        <module>09-agent-patterns</module>
        <module>10-langgraph-basics</module>
        <module>11-multi-agent</module>
        <module>12-production</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <langchain4j.version>1.0.1</langchain4j.version>
        <langgraph4j.version>1.5.5</langgraph4j.version>
        <mcp-sdk.version>0.10.0</mcp-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-core</artifactId>
                <version>${langgraph4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-langchain4j</artifactId>
                <version>${langgraph4j.version}</version>
            </dependency>

            <dependency>
                <groupId>com.study.aiagents</groupId>
                <artifactId>common-llm</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
