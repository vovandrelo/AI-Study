# Скопируй этот файл в .env и подставь реальные значения.
# .env подхватывается через spring-dotenv или загружается вручную.

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Локальная модель Ollama (на время отсутствия ключа Claude)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Профиль провайдера: anthropic | ollama
LLM_PROVIDER=ollama
