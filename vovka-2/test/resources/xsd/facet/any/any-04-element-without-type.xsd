<?xml version="1.0" encoding="UTF-8"?>
<!--
  ЗАПРЕТ ВСЕЯДНЫХ КОНСТРУКЦИЙ. Запрещены xs:any, xs:anyType и xs:anySimpleType, в том числе неявные:
  элемент без типа получает xs:anyType, атрибут без типа получает xs:anySimpleType.

  ЧТО НАРУШЕНО:
    Элемент untyped объявлен без type и без вложенного типа.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    По стандарту такой элемент неявно получает тип xs:anyType, то есть принимает что угодно.
    Самая коварная форма нарушения: достаточно забыть написать type.

  КАК ИСПРАВИТЬ:
    Указать type или вложенный simpleType / complexType.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    элемент 'untyped' объявлен без типа и неявно имеет тип xs:anyType
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- НАРУШЕНИЕ: нет ни type, ни вложенного типа -->
    <xs:element name="untyped"/>

</xs:schema>
