<?xml version="1.0" encoding="UTF-8"?>
<!--
  ЗАПРЕТ ВСЕЯДНЫХ КОНСТРУКЦИЙ. Запрещены xs:any, xs:anyType и xs:anySimpleType, в том числе неявные:
  элемент без типа получает xs:anyType, атрибут без типа получает xs:anySimpleType.

  ЧТО НАРУШЕНО:
    Тип Payload расширяет xs:anyType.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Extension от xs:anyType означает «всё что угодно плюс ещё что-то». В отличие от
    restriction base="xs:anyType" (см. ok-12), здесь содержимое не ограничено.

  КАК ИСПРАВИТЬ:
    Обычный complexType с конкретной моделью содержимого.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:extension> base="xs:anyType" (в <xs:complexType name="Payload">)
    использование xs:anyType запрещено
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- Вспомогательный тип: строка до 50 символов. Сам правила не нарушает. -->
    <xs:simpleType name="Name">
        <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="Payload">
        <xs:complexContent>
            <!-- НАРУШЕНИЕ: расширение xs:anyType -->
            <xs:extension base="xs:anyType">
                <xs:attribute name="id" type="t:Name"/>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

</xs:schema>
