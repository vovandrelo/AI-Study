<?xml version="1.0" encoding="UTF-8"?>
<!--
  ЗАПРЕТ ВСЕЯДНЫХ КОНСТРУКЦИЙ. Запрещены xs:any, xs:anyType и xs:anySimpleType, в том числе неявные:
  элемент без типа получает xs:anyType, атрибут без типа получает xs:anySimpleType.

  ЧТО НАРУШЕНО:
    Атрибут flag объявлен с type="xs:anySimpleType".

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    xs:anySimpleType разрешает любой текст.

  КАК ИСПРАВИТЬ:
    Указать конкретный ограниченный тип.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:attribute name="flag"> type="xs:anySimpleType"
    использование xs:anySimpleType запрещено
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:element name="item">
        <xs:complexType>
            <!-- НАРУШЕНИЕ: явный xs:anySimpleType -->
            <xs:attribute name="flag" type="xs:anySimpleType"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
