<?xml version="1.0" encoding="UTF-8"?>
<!--
  ОГРАНИЧЕНИЕ ЧИСЕЛ. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО НАРУШЕНО:
    Тип Delta ограничен только xs:maxExclusive.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Есть верхняя граница, но нет нижней: число может быть сколь угодно малым.

  КАК ИСПРАВИТЬ:
    Добавить xs:minInclusive или xs:minExclusive.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:restriction base="xs:integer"> (в <xs:simpleType name="Delta">)
    должен быть задан xs:totalDigits либо пара
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="Delta">
        <xs:restriction base="xs:integer">
            <!-- НАРУШЕНИЕ: нет нижней границы -->
            <xs:maxExclusive value="100"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
