<?xml version="1.0" encoding="UTF-8"?>
<!--
  ДОПУСТИМЫЙ ВАРИАНТ. ЗАПРЕТ ВСЕЯДНЫХ КОНСТРУКЦИЙ. Запрещены xs:any, xs:anyType и xs:anySimpleType, в том числе неявные:
  элемент без типа получает xs:anyType, атрибут без типа получает xs:anySimpleType.

  ЧТО ПРОВЕРЯЕМ:
    Элемент разрешает любые атрибуты через xs:anyAttribute.

  ПОЧЕМУ ЭТО НЕ НАРУШЕНИЕ:
    Требование перечисляет только xs:any, xs:anyType и xs:anySimpleType. xs:anyAttribute
    в него не входит и ОСОЗНАННО не проверяется. Если требование расширят, этот тест
    нужно перевести в нарушения.

  ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
    Валидация проходит без исключения.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- Вспомогательный тип: строка до 50 символов. Сам правила не нарушает. -->
    <xs:simpleType name="Name">
        <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:element name="tagged">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="value" type="t:Name"/>
            </xs:sequence>
            <xs:anyAttribute processContents="lax"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
