<?xml version="1.0" encoding="UTF-8"?>
<!--
  ДОПУСТИМЫЙ ВАРИАНТ. ОГРАНИЧЕНИЕ СТРОК И ЧИСЕЛ.

  ЧТО ПРОВЕРЯЕМ:
    Элементы со встроенными типами, которых нет в списках правил.

  ПОЧЕМУ ЭТО НЕ НАРУШЕНИЕ:
    xs:int и xs:long ограничены по определению; xs:date и xs:boolean не строки и не числа.
    xs:token не проверяется ОСОЗНАННО: требование говорит только про xs:string, производные
    строковые типы (xs:token, xs:normalizedString и другие) в него не входят.

  ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
    Валидация проходит без исключения.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:element name="values">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="count"   type="xs:int"/>
                <xs:element name="id"      type="xs:long"/>
                <xs:element name="created" type="xs:date"/>
                <xs:element name="paid"    type="xs:boolean"/>
                <xs:element name="token"   type="xs:token"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
