<?xml version="1.0" encoding="UTF-8"?>
<!--
  ДОПУСТИМЫЙ ВАРИАНТ. ОГРАНИЧЕНИЕ СТРОК И ЧИСЕЛ.

  ЧТО ПРОВЕРЯЕМ:
    Элемент с текстом и атрибутом: extension от ограниченных Amount, атрибут ограниченного типа.

  ПОЧЕМУ ЭТО НЕ НАРУШЕНИЕ:
    Extension не сужает текст, поэтому base должен быть уже ограниченным типом. Здесь так и есть.

  ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
    Валидация проходит без исключения.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- Вспомогательный тип: строка до 50 символов. Сам правила не нарушает. -->
    <xs:simpleType name="Name">
        <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Вспомогательный тип: сумма до 18 цифр. Сам правила не нарушает. -->
    <xs:simpleType name="Amount">
        <xs:restriction base="xs:decimal">
            <xs:totalDigits value="18"/>
            <xs:fractionDigits value="2"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="Money">
        <xs:simpleContent>
            <xs:extension base="t:Amount">
                <xs:attribute name="currency" type="t:Name" use="required"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
    <xs:element name="price" type="t:Money"/>

</xs:schema>
