<?xml version="1.0" encoding="UTF-8"?>
<!--
  ОГРАНИЧЕНИЕ СТРОК. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО НАРУШЕНО:
    Атрибут code объявлен с type="xs:string".

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    У атрибутов тоже простой тип, и строка без ограничений допускает значение любой длины.

  КАК ИСПРАВИТЬ:
    type="t:Name" с ограниченным типом.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:attribute name="code"> type="xs:string"
    для строкового типа должно быть задано ограничение
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:element name="item">
        <xs:complexType>
            <!-- НАРУШЕНИЕ: атрибут с неограниченной строкой -->
            <xs:attribute name="code" type="xs:string"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
