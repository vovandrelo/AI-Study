<?xml version="1.0" encoding="UTF-8"?>
<!--
  НЕСКОЛЬКО ФАЙЛОВ. Нарушение в ИМПОРТИРУЕМОМ файле. ОГРАНИЧЕНИЕ СТРОК. Строковый тип (xs:string) должен быть ограничен xs:length, xs:maxLength, xs:enumeration или xs:pattern.

  ЧТО НАРУШЕНО:
    Главный файл сам по себе чистый. Он импортирует types.xsd, а в types.xsd
    элемент note объявлен с type="xs:string".

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Проверяются все файлы схемы, а не только главный. Иначе неограниченный тип можно было бы
    спрятать в подключаемый файл.

  КАК ИСПРАВИТЬ:
    Ограничить тип в types.xsd.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    [xsd/facet/multifile/import-violation/types.xsd]
    <xs:element name="note"> type="xs:string"
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           xmlns:ty="urn:test:types"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:import namespace="urn:test:types" schemaLocation="types.xsd"/>

    <!-- Главный файл без нарушений -->
    <xs:element name="order">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="ty:note"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
