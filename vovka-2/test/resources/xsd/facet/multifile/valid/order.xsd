<?xml version="1.0" encoding="UTF-8"?>
<!--
  НЕСКОЛЬКО ФАЙЛОВ. ДОПУСТИМЫЙ ВАРИАНТ. Все проверки.

  ЧТО ПРОВЕРЯЕМ:
    Итоговая схема заказа из трёх файлов: order.xsd (главный), address.xsd (xs:include,
    то же пространство имён) и common.xsd (xs:import, другое пространство имён).
    Схема использует все разрешённые конструкции: ограниченные строки и числа, list, union,
    simpleContent, complexContent extension, group, attributeGroup, ref, substitutionGroup.

  ПОЧЕМУ ЭТО НЕ НАРУШЕНИЕ:
    Все типы ограничены, нет xs:any, xs:anyType, xs:anySimpleType.

  ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
    Валидация проходит без исключения; проверяются все три файла.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:o="urn:shop:order"
           xmlns:c="urn:shop:common"
           targetNamespace="urn:shop:order"
           elementFormDefault="qualified">

    <!-- Другое пространство имён — import -->
    <xs:import namespace="urn:shop:common" schemaLocation="common.xsd"/>
    <!-- То же пространство имён — include -->
    <xs:include schemaLocation="address.xsd"/>

    <!-- ===== Простые типы ===== -->
    <xs:simpleType name="OrderNumber">
        <xs:restriction base="xs:string">
            <xs:pattern value="ORD-[0-9]{6}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Status">
        <xs:restriction base="xs:string">
            <xs:enumeration value="NEW"/>
            <xs:enumeration value="PAID"/>
            <xs:enumeration value="SHIPPED"/>
            <xs:enumeration value="CANCELLED"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="ShortName">
        <xs:restriction base="o:Text100">          <!-- Text100 — из address.xsd -->
            <xs:maxLength value="30"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Phone">
        <xs:restriction base="xs:string">
            <xs:pattern value="\+7[0-9]{10}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Sku">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{3}-[0-9]{4}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Quantity">
        <xs:restriction base="xs:positiveInteger">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="999"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TagCode">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{2,10}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Tags">
        <xs:list itemType="o:TagCode"/>
    </xs:simpleType>

    <xs:simpleType name="Asap">
        <xs:restriction base="xs:string">
            <xs:enumeration value="ASAP"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="DeliveryDate">
        <xs:union memberTypes="xs:date o:Asap"/>
    </xs:simpleType>

    <xs:simpleType name="CardMask">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{4}\*{8}[0-9]{4}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===== Переиспользуемые куски ===== -->
    <xs:group name="ContactGroup">
        <xs:sequence>
            <xs:element name="phone" type="o:Phone"/>
            <xs:element name="email" type="o:Text100" minOccurs="0"/>
        </xs:sequence>
    </xs:group>

    <xs:attributeGroup name="Audit">
        <xs:attribute name="createdBy" type="o:ShortName" use="required"/>
        <xs:attribute name="version"   type="xs:int"/>
    </xs:attributeGroup>

    <!-- ===== Сложные типы ===== -->
    <xs:complexType name="Item">
        <xs:sequence>
            <xs:element name="name"     type="o:Text100"/>
            <xs:element name="quantity" type="o:Quantity"/>
            <xs:element name="price"    type="c:Money"/>     <!-- тип из common.xsd -->
        </xs:sequence>
        <xs:attribute name="sku"  type="o:Sku" use="required"/>
        <xs:attribute name="gift" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="Payment">
        <xs:sequence>
            <xs:element name="amount" type="c:Money"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="CardPayment">
        <xs:complexContent>
            <xs:extension base="o:Payment">
                <xs:sequence>
                    <xs:element name="cardMask" type="o:CardMask"/>
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <!-- ===== Глобальные элементы ===== -->
    <xs:element name="payment"     type="o:Payment" abstract="true"/>
    <xs:element name="cardPayment" type="o:CardPayment" substitutionGroup="o:payment"/>
    <xs:element name="cashPayment" substitutionGroup="o:payment"/>

    <xs:element name="order">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="number" type="o:OrderNumber"/>
                <xs:element name="status" type="o:Status"/>
                <xs:element name="customer">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="name" type="o:Text100"/>
                            <xs:group ref="o:ContactGroup"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="delivery"     type="o:DeliveryAddress"/>
                <xs:element name="deliveryDate" type="o:DeliveryDate"/>
                <xs:element name="items">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="item" type="o:Item" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element ref="o:payment"/>
                <xs:element name="tags" type="o:Tags" minOccurs="0"/>
                <xs:element name="comment" minOccurs="0">
                    <xs:simpleType>
                        <xs:restriction base="xs:string">
                            <xs:maxLength value="500"/>
                        </xs:restriction>
                    </xs:simpleType>
                </xs:element>
            </xs:sequence>
            <xs:attributeGroup ref="o:Audit"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
