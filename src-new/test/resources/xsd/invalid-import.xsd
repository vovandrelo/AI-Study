<?xml version="1.0" encoding="UTF-8"?>
<!--
  ЭТАП 1 (ограничение валидатора): xs:import / xs:include не загружаются —
  внешний доступ запрещён (ACCESS_EXTERNAL_SCHEMA = ""). Поддерживаются только самодостаточные схемы.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:c="urn:test:common">

    <!-- НАРУШЕНИЕ (этап 1): импортируемую схему загрузить нельзя -->
    <xs:import namespace="urn:test:common" schemaLocation="common.xsd"/>

    <xs:element name="money" type="c:Money"/>

</xs:schema>
