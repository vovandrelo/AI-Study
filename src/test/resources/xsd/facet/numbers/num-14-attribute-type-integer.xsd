<?xml version="1.0" encoding="UTF-8"?>
<!--
  ОГРАНИЧЕНИЕ ЧИСЕЛ. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО НАРУШЕНО:
    Атрибут version объявлен с type="xs:integer".

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Правило действует и на атрибуты.

  КАК ИСПРАВИТЬ:
    type с ограниченным числовым типом или xs:int.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:attribute name="version"> type="xs:integer"
    числовой тип не ограничен
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:element name="doc">
        <xs:complexType>
            <!-- НАРУШЕНИЕ: атрибут с неограниченным целым -->
            <xs:attribute name="version" type="xs:integer"/>
        </xs:complexType>
    </xs:element>

</xs:schema>
