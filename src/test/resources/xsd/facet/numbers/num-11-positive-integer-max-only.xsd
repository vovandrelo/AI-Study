<?xml version="1.0" encoding="UTF-8"?>
<!--
  ОГРАНИЧЕНИЕ ЧИСЕЛ. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО НАРУШЕНО:
    Тип Count на основе xs:positiveInteger ограничен только xs:maxInclusive.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Требование: либо xs:totalDigits, либо min и max. У xs:positiveInteger по стандарту есть
    нижний предел 1, но требование говорит о параметрах схемы, поэтому обе границы
    нужно задать ЯВНО. Встроенная граница не засчитывается.

  КАК ИСПРАВИТЬ:
    Добавить xs:minInclusive value="1".

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:restriction> base="xs:positiveInteger" (в <xs:simpleType name="Count">)
    числовой тип не ограничен
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:simpleType name="Count">
        <xs:restriction base="xs:positiveInteger">
            <!-- НАРУШЕНИЕ: нижняя граница не задана явно -->
            <xs:maxInclusive value="999"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
