<?xml version="1.0" encoding="UTF-8"?>
<!--
  ОГРАНИЧЕНИЕ ЧИСЕЛ. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО НАРУШЕНО:
    Элемент value объявлен с type="xs:decimal".

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    У xs:decimal нет верхнего предела: ссылка по имени не даёт добавить ограничения.

  КАК ИСПРАВИТЬ:
    Объявить свой simpleType с restriction и xs:totalDigits (или min + max) и сослаться на него.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:element name="value"> type="xs:decimal"
    числовой тип не ограничен
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- НАРУШЕНИЕ: type="xs:decimal" без ограничений -->
    <xs:element name="value" type="xs:decimal"/>

</xs:schema>
