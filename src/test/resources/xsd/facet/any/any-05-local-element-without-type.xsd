<?xml version="1.0" encoding="UTF-8"?>
<!--
  ЗАПРЕТ ВСЕЯДНЫХ КОНСТРУКЦИЙ. Запрещены xs:any, xs:anyType и xs:anySimpleType, в том числе неявные:
  элемент без типа получает xs:anyType, атрибут без типа получает xs:anySimpleType.

  ЧТО НАРУШЕНО:
    Вложенный элемент data внутри complexType объявлен без типа.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Неявный xs:anyType появляется на любом уровне вложенности.

  КАК ИСПРАВИТЬ:
    Указать type.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:element name="data">
    объявлен без типа и неявно имеет тип xs:anyType
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <xs:element name="container">
        <xs:complexType>
            <xs:sequence>
                <!-- НАРУШЕНИЕ: локальный элемент без типа -->
                <xs:element name="data"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
