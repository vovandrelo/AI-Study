<?xml version="1.0" encoding="UTF-8"?>
<!--
  ДОПУСТИМЫЙ ВАРИАНТ. ЗАПРЕТ ВСЕЯДНЫХ КОНСТРУКЦИЙ. Запрещены xs:any, xs:anyType и xs:anySimpleType, в том числе неявные:
  элемент без типа получает xs:anyType, атрибут без типа получает xs:anySimpleType.

  ЧТО ПРОВЕРЯЕМ:
    Сложный тип записан в длинной форме: restriction от xs:anyType.

  ПОЧЕМУ ЭТО НЕ НАРУШЕНИЕ:
    Это та же самая запись, что и обычный complexType без base. Restriction сужает xs:anyType
    до конкретной модели, поэтому произвольного содержимого здесь нет.

  ОЖИДАЕМЫЙ РЕЗУЛЬТАТ:
    Валидация проходит без исключения.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:test:facet"
           targetNamespace="urn:test:facet"
           elementFormDefault="qualified">

    <!-- Вспомогательный тип: строка до 50 символов. Сам правила не нарушает. -->
    <xs:simpleType name="Name">
        <xs:restriction base="xs:string">
            <xs:maxLength value="50"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="Point">
        <xs:complexContent>
            <xs:restriction base="xs:anyType">
                <xs:sequence>
                    <xs:element name="label" type="t:Name"/>
                </xs:sequence>
            </xs:restriction>
        </xs:complexContent>
    </xs:complexType>
    <xs:element name="point" type="t:Point"/>

</xs:schema>
