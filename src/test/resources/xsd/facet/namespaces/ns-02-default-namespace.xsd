<?xml version="1.0" encoding="UTF-8"?>
<!--
  ПРЕФИКСЫ. ОГРАНИЧЕНИЕ ЧИСЕЛ. Типы xs:decimal, xs:integer, xs:positiveInteger, xs:nonNegativeInteger, xs:negativeInteger,
  xs:nonPositiveInteger должны быть ограничены xs:totalDigits ЛИБО парой
  xs:minInclusive/xs:minExclusive и xs:maxInclusive/xs:maxExclusive.

  ЧТО НАРУШЕНО:
    XML Schema объявлена пространством имён ПО УМОЛЧАНИЮ (xmlns без префикса).
    Элемент amount объявлен с type="decimal", тоже без префикса.

  ПОЧЕМУ ЭТО НАРУШЕНИЕ:
    Имя без префикса относится к пространству по умолчанию, то есть к XML Schema.
    type="decimal" здесь это встроенный xs:decimal без ограничений.

  КАК ИСПРАВИТЬ:
    Свой ограниченный тип с xs:totalDigits.

  ОЖИДАЕМОЕ СООБЩЕНИЕ (фрагменты):
    <xs:element name="amount"> type="decimal"
    числовой тип не ограничен
-->
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:t="urn:test:facet"
        targetNamespace="urn:test:facet"
        elementFormDefault="qualified">

    <!-- НАРУШЕНИЕ: decimal без префикса это xs:decimal -->
    <element name="amount" type="decimal"/>

</schema>
